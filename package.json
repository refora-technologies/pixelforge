{
  "name": "pixelforge",
  "version": "1.2.0",
  "description": "AI-powered image upscaling and compression automation by Refora Technologies",
  "main": "main.js",
  "author": "Refora Technologies",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "lint": "eslint .",
    "test": "node tools/test-updater.js && node tools/test-startup.js && electron tools/test-pipeline.js && electron tools/test-settings-ui.js && electron tools/test-compare-ui.js",
    "test:pipeline": "electron tools/test-pipeline.js",
    "test:settings": "electron tools/test-settings-ui.js",
    "test:compare": "electron tools/test-compare-ui.js",
    "test:startup": "node tools/test-startup.js",
    "test:update-flow": "electron tools/test-update-flow.js",
    "verify:release": "electron tools/verify-release.js",
    "verify:installer": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/verify-installer.ps1",
    "shoot": "electron tools/shoot.js",
    "build": "electron-builder --win",
    "build:dir": "electron-builder --win --dir"
  },
  "dependencies": {
    "electron-store": "^8.2.0",
    "extract-zip": "^2.0.1"
  },
  "devDependencies": {
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "eslint": "^8.57.0"
  },
  "build": {
    "appId": "com.reforatech.pixelforge",
    "productName": "PixelForge",
    "copyright": "Copyright © 2026 Refora Technologies. All rights reserved.",
    "directories": {
      "output": "dist",
      "buildResources": "assets"
    },
    "files": [
      "main.js",
      "preload.js",
      "src/**/*",
      "!src/models/**/*",
      "assets/**/*",
      "node_modules/**/*",
      "!node_modules/.cache/**/*"
    ],
    "extraResources": [
      {
        "from": "src/models",
        "to": "models"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico",
      "requestedExecutionLevel": "asInvoker"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "allowElevation": true,
      "license": "build/license.txt",
      "installerIcon": "assets/icon.ico",
      "uninstallerIcon": "assets/icon.ico",
      "installerHeaderIcon": "assets/icon.ico",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "PixelForge",
      "include": "build/installer.nsh",
      "artifactName": "PixelForge-Setup.exe"
    }
  }
}
