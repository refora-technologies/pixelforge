#!/bin/sh
# Fast checks before every commit (a few seconds). The Electron suites run with
# `npm test`. Enabled by `npm install` (see "prepare"); skip once with --no-verify.

unset ELECTRON_RUN_AS_NODE
log="$(git rev-parse --git-dir)/pre-commit.log"

run() {
  if ! "$@" > "$log" 2>&1; then
    echo "pre-commit: '$*' failed:" >&2
    tail -n 30 "$log" >&2
    exit 1
  fi
}

run npx --no-install eslint .
run node tools/test-contract.js
run node tools/test-unit.js
run node tools/test-updater.js
